#!/bin/bash
#
# Shell script to create Mac Release Files
#
# Usage: release-MacOSX
#

#Qt:
QTSPIM="QtSpim.app"
ASST="Assistant.app"

HELP_DIR="help"
HELP_FILES="qtspim.*"

BUILD_DIR="build-QtSpim-Qt-Release"
RELEASE_DIR="build_Release"
QT_BIN_DIR="/opt/homebrew/Cellar/qt@5/5.15.10/bin"

rm -fr $RELEASE_DIR
mkdir $RELEASE_DIR
  
#Fix QtSpim
cp -PR $BUILD_DIR/$QTSPIM $RELEASE_DIR
$QT_BIN_DIR/macdeployqt $RELEASE_DIR/$QTSPIM -verbose=2 -no-strip

#Help files
mkdir $RELEASE_DIR/$QTSPIM/Contents/Resources/doc
cp -RP $BUILD_DIR/$HELP_DIR/$HELP_FILES $RELEASE_DIR/$QTSPIM/Contents/Resources/doc

#Fix Qt Assistant
cp -PR $QT_BIN_DIR/../libexec/$ASST $RELEASE_DIR
$QT_BIN_DIR/macdeployqt $RELEASE_DIR/$ASST -verbose=2 -no-strip
cp -RP $RELEASE_DIR/$ASST/Contents/MacOS/Assistant $RELEASE_DIR/$QTSPIM/Contents/MacOS
cp -nRP $RELEASE_DIR/$ASST/Contents/Frameworks/* $RELEASE_DIR/$QTSPIM/Contents/Frameworks
cp -nRP $RELEASE_DIR/$ASST/Contents/PlugIns/* $RELEASE_DIR/$QTSPIM/Contents/PlugIns

# QtSpim does not use Qt Virtual Keyboard. Assistant's complete plugin copy
# above can pull in this separately licensed optional component, so exclude it
# from the final QtSpim application bundle.
APP_CONTENTS="$RELEASE_DIR/$QTSPIM/Contents"
if /usr/bin/otool -L "$APP_CONTENTS/MacOS/QtSpim" \
  | /usr/bin/grep -Eiq 'QtVirtualKeyboard|libqtvirtualkeyboard'; then
	echo "QtSpim executable links Qt Virtual Keyboard; refusing to remove a required library." >&2
	exit 1
fi

/usr/bin/find "$APP_CONTENTS" \
	\( -name 'QtVirtualKeyboard.framework' \
	   -o -name 'libqtvirtualkeyboard*.dylib' \
	   -o -iname 'virtualkeyboard' \
	   -o -path '*/qml/QtQuick/VirtualKeyboard' \) \
	-prune -exec rm -rf {} +

if /usr/bin/find "$APP_CONTENTS" \
	\( -iname '*virtualkeyboard*' -o -iname '*virtual-keyboard*' \) \
	-print -quit | /usr/bin/grep -q .; then
	echo "Qt Virtual Keyboard files remain in the app bundle." >&2
	exit 1
fi
